{
  "name": "@norma/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./presets/software-dev": {
      "types": "./src/presets/software-dev.ts",
      "import": "./src/presets/software-dev.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@norma/core": "workspace:*",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@norma/tsconfig": "workspace:*",
    "@norma/tsup-config": "workspace:*",
    "tsup": "8.3.5",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
