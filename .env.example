# Harness CORE — credentials (copy to .env, never commit the filled file).

# --- Linear adapter ---
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxx
LINEAR_TEAM=Redisco

# --- Jira Cloud adapter ---
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=xxxxxxxxxxxxxxxxxxxx
JIRA_PROJECT=ENG

# --- Claude Code agent runtime (for autonomous / sandbox runs) ---
# From `claude setup-token`; the sandbox can't read the host keychain.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: GitHub token for `gh pr create` at epic completion.
GH_TOKEN=

# --- cron / sandbox ---
NORMA_PROJECT=
# NORMA_CONFIG=examples/jira.config.json
# NORMA_ALLOW_DOMAINS=your-site.atlassian.net
