{
  "name": "@norma/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Norma — provider-agnostic orchestration engine for AI agent pipelines (DAG + loop + context handoff).",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "norma": "pnpm --filter @norma/cli exec norma",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "turbo": "2.10.12",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
